# ---------------------------------------------------------------------------
# pdf-utility configuration
# Copy to .env and adjust for your deployment:  cp .env.example .env
# ---------------------------------------------------------------------------

# Port the Node process listens on (inside the container).
PORT=3001

NODE_ENV=production

# Where uploads and generated files are written. In Docker these point at the
# /data volume, so temporary files never touch the container's own layer.
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs

# How long a file stays on disk before the cleanup job removes it (minutes).
FILE_EXPIRY_MIN=30

# Upload limits.
MAX_FILE_SIZE_MB=50
MAX_FILES=50

# Upper bound on tracked temporary files; the oldest entries are evicted first.
MAX_TRACKED_FILES=20000

# Cleanup job interval, in milliseconds.
CLEANUP_INTERVAL_MS=60000

# Rate limiting (applies per client IP).
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=60

# Maximum JSON body size. The compression flow posts base64 page images here.
JSON_LIMIT=25mb

# Set to false only when the app is exposed directly, without a proxy.
# When true, X-Forwarded-For is trusted so rate limiting sees real client IPs.
TRUST_PROXY=true

# Leave empty for same-origin only (recommended) — the frontend is served by
# this same app. Set to your domain to allow one extra origin, or to * to
# re-open CORS to every origin.
# FRONTEND_ORIGIN=https://pdf.farzani.my.id
FRONTEND_ORIGIN=
